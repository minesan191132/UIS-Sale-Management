              <!-- Expanded order breakdown -->
              <tr v-if="expandedDrawing === item.drawingNumber">
                <td colspan="9" class="p-0 border-0">
                  <div class="expand-content bg-white border-start border-4 border-primary ms-4 p-3 my-1 rounded shadow-sm">

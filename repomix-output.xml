      if (error.response?.status === 400 && error.response?.data?.details) {
        errors.value = error.response.data.details;
      }
  
      Swal.fire({
        icon: 'error',
        title: 'Gửi thất bại',
        text: error.response?.data?.message || error.response?.data?.error || 'Không thể kết nối đến máy chủ',

                  <p class="text-muted mb-2">
                    <i class="bi bi-box me-2"></i>
                    {{ order.items?.length || 0 }} sản phẩm
                  </p>
                  <span :class="getStatusBadgeClass(order.status)">
                    {{ getStatusText(order.status, order.orderType) }}

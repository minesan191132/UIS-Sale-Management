            return ResponseEntity.badRequest().body(Map.of("error", "Vui lòng nhập nội dung tin nhắn."));
        }

        contactService.sendContactEmail(dto);
        return ResponseEntity.ok(Map.of("message", "Yêu cầu của bạn đã được gửi thành công!"));
    }
